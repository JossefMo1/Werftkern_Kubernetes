#!/bin/sh
set -eu
if [ "$1" = configure ]; then
  for command in /usr/bin/werft /usr/bin/werft-ops; do
    if [ ! -x "$command" ]; then
      printf 'Werftkern package is incomplete: missing executable %s\n' "$command" >&2
      exit 1
    fi
  done
  if ! command -v ssh >/dev/null 2>&1; then
    printf 'Werftkern package is incomplete: openssh-client/ssh is unavailable\n' >&2
    exit 1
  fi
  # Check the installed entry points before declaring the package configured.
  # This catches a broken Python module path or binary at apt/dpkg time rather
  # than leaving an apparently installed package whose documented commands fail.
  if ! /usr/bin/werft --help >/dev/null 2>&1; then
    printf 'Werftkern package is incomplete: /usr/bin/werft cannot start\n' >&2
    exit 1
  fi
  if ! /usr/bin/werft-ops --help >/dev/null 2>&1; then
    printf 'Werftkern package is incomplete: /usr/bin/werft-ops cannot start\n' >&2
    exit 1
  fi
  if ! getent passwd wk-runtime >/dev/null; then
    adduser --system --group --home /nonexistent --no-create-home --disabled-login wk-runtime
  fi
  install -d -m 0755 /var/lib/werftkern
  install -d -m 0700 /var/lib/werftkern/volumes
  if [ -d /run/systemd/system ]; then systemctl daemon-reload; fi
  printf '\nWerftkern experimental alpha installed.\nStart explicitly with: sudo werft setup\nThis local build is unsigned and not production-qualified.\n'
fi
