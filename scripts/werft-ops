#!/usr/bin/env python3
import pathlib
import runpy
import sys

prefix = pathlib.Path(__file__).resolve().parents[1]
installed = prefix / "lib" / "werftkern" / "ops"
source = prefix / "ops"


def package_root():
    for candidate in (installed, source):
        package = candidate / "werftops"
        if (package / "__init__.py").is_file() and (package / "__main__.py").is_file():
            return candidate
    print("werft-ops: Python modules not found", file=sys.stderr)
    raise SystemExit(78)


sys.path.insert(0, str(package_root()))
runpy.run_module("werftops", run_name="__main__")
